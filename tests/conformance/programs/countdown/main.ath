// Build the drocta-style positive integer 3 — a chain of objects whose
// left half is alive for "successor" levels and NULL at the base — then
// recurse on it, printing "tick" once per level.
//
// Encoding (per learn-tilde-ath blog):
//   1 = compose(NULL, anything)
//   n+1 = compose(alive-sentinel, n)

importf "countdown.ath" as COUNTDOWN;

import sentinel S;
BIFURCATE [NULL, S] ONE;
BIFURCATE [S, ONE]  TWO;
BIFURCATE [S, TWO]  THREE;

COUNTDOWN THREE [A, B];

print done;
THIS.DIE();
