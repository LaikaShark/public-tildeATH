// SPEC §4.8.4 — ASCII uppercase conversion.
//
//   UPPER [S, _] R;
//
// R is a fresh cons-list with every ASCII a-z byte mapped to A-Z.
// Non-letter bytes pass through unchanged. Inherits S as a dep.

import builtin ath_upper as ATH_UPPER;
BIFURCATE ARGS [X, Y];
ATH_UPPER [X, Y] R;
THIS.DIE(R);
