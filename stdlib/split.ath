// SPEC §4.8.4 — split a string into a cons-list of substrings.
//
//   SPLIT [S, SEP] LIST;
//
// LIST is a right-nested cons-list whose left halves are themselves
// cons-list strings. The empty separator is born dead. A trailing
// SEP yields a trailing empty-string element.

IMPORT BUILTIN ath_split AS ATH_SPLIT;
BIFURCATE ARGS[X, Y];
ATH_SPLIT[X, Y] R;
THIS.DIE(R);
