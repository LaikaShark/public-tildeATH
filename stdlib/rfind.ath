// SPEC §4.8.4 — last index of NEEDLE in HAY.
//
//   RFIND [HAY, NEEDLE] IDX;
//
// IDX is an int64-payload object holding the 0-indexed position of the
// last occurrence of NEEDLE in HAY. Born dead if NEEDLE is absent or an
// operand is dead. Empty NEEDLE matches at len(HAY).

IMPORT BUILTIN ath_rfind AS ATH_RFIND;
BIFURCATE ARGS[X, Y];
ATH_RFIND[X, Y] R;
THIS.DIE(R);
