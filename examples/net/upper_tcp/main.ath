// An uppercase-transform server and client over TCP (127.0.0.1:9102), in one
// process. Same shape as upper_unix; only the transport differs.
// Output: HELLO, then WORLD, then done.
IMPORTF "server.ath" AS SERVER;
IMPORTF "client.ath" AS CLIENT;
UNIVERSE AS N;
SPAWN SERVER NULL INTO N AS S;
SPAWN CLIENT NULL INTO N AS C;
JOIN N;
PRINT done;
THIS.DIE();
