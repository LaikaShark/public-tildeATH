// Spawn an echo server and a client that talk over a Unix-domain socket in one process. The
// cooperative scheduler interleaves them; a connection is just a channel whose liveness tracks
// the socket. Output: hello, then world, then done.
IMPORTF "server.ath" AS SERVER;
IMPORTF "client.ath" AS CLIENT;
UNIVERSE AS N;
SPAWN SERVER NULL INTO N AS S;
SPAWN CLIENT NULL INTO N AS C;
JOIN N;
PRINT done;
THIS.DIE();
