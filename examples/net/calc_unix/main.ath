// A sum-the-two-integers request/response server and its client, over a
// Unix-domain socket. Output: 42, then 12, then done.
IMPORTF "server.ath" AS SERVER;
IMPORTF "client.ath" AS CLIENT;
NURSERY AS N;
SPAWN SERVER NULL INTO N AS S;
SPAWN CLIENT NULL INTO N AS C;
JOIN N;
PRINT done;
THIS.DIE();
