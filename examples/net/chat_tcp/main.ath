// A chat relay over TCP (127.0.0.1:9104): a server multiplexes two clients
// (alice and bob) into one transcript, then prints done. Same shape as chat_unix.
IMPORTF "server.ath" AS SERVER;
IMPORTF "alice.ath" AS ALICE;
IMPORTF "bob.ath" AS BOB;
UNIVERSE AS N;
SPAWN SERVER NULL INTO N AS S;
SPAWN ALICE NULL INTO N AS A;
SPAWN BOB NULL INTO N AS B;
JOIN N;
PRINT done;
THIS.DIE();
