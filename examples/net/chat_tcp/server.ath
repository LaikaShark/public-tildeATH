// TCP variant of chat_unix: a chat room on a TCP port. Accept K clients; spawn
// one handler actor per connection (served concurrently via the cooperative
// scheduler), and fan their messages into a single transcript channel that a
// printer actor drains in arrival order.
// (Not in the conformance suite: a real port is non-deterministic in CI.)
IMPORTF "handler.ath" AS HANDLER;
IMPORTF "printer.ath" AS PRINTER;
IMPORT NUMBER 2 AS K;
LISTEN 9104 AS L;
CHANNEL AS LOG;
SPAWN PRINTER LOG AS P;
UNIVERSE AS HN;
LOOP K
{
    ACCEPT FROM L AS CONN;
    BIFURCATE [CONN, LOG] HARG;
    SPAWN HANDLER HARG INTO HN AS H;
}
JOIN HN;        // every client has hung up
CLOSE LOG;      // the printer stops at EOF
JOIN P;
CLOSE L;
THIS.DIE();
