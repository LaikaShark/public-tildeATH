// A sum-the-two-integers request/response server and client over TCP
// (127.0.0.1:9103), in one process. Same shape as calc_unix.
// Output: 42, then 12, then done.
IMPORTF "server.ath" AS SERVER;
IMPORTF "client.ath" AS CLIENT;
UNIVERSE AS N;
SPAWN SERVER NULL INTO N AS S;
SPAWN CLIENT NULL INTO N AS C;
JOIN N;
PRINT done;
THIS.DIE();
