// The ~ATH(!V) form: run while V is *dead*. Since objects can't come back
// to life, the body either runs at-most-once (if V is dead at entry) and
// must rebind V to break out, or never runs (if V is alive at entry).

import x V;
V.DIE();
~ATH(!V) {
    print V is currently dead;
    // Rebind V to a fresh alive composite to exit the inverted loop
    // without disturbing the dead sentinel above.
    BIFURCATE [NULL, NULL] V;
}
print after the loop;
THIS.DIE();
