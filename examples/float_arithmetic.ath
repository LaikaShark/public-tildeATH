// Demonstrates float payloads and the numeric tower (§4.8, §10.2).
//
//   athc examples/float_arithmetic.ath -o fa
//   ./fa
//   # expected:
//   # pi = 3.14
//   # 3.14 + 7 = 10.14
//   # 7 / 2.0 = 3.5
//   # floor(3.14) = 3.0
//   # trunc(3.14) = 3
//   # parse 2.5e3 = 2500.0

IMPORTF <to_string> AS TO_STRING;
IMPORTF <add> AS ADD;
IMPORTF <div> AS DIV;
IMPORTF <floor> AS FLOOR;
IMPORTF <float_to_int> AS FLOAT_TO_INT;
IMPORTF <parse> AS PARSE;

IMPORT NUMBER 3.14 AS PI;
IMPORT NUMBER 7 AS SEVEN;
IMPORT NUMBER 2.0 AS TWO;

TO_STRING[PI, PI] PS;
PRINT pi = $PS;

ADD[PI, SEVEN] SUM;
TO_STRING[SUM, SUM] SUMS;
PRINT 3.14 + 7 = $SUMS;

DIV[SEVEN, TWO] HALF;
TO_STRING[HALF, HALF] HS;
PRINT 7 / 2.0 = $HS;

FLOOR[PI, PI] FL;
TO_STRING[FL, FL] FLS;
PRINT floor(3.14) = $FLS;

FLOAT_TO_INT[PI, PI] TI;
TO_STRING[TI, TI] TIS;
PRINT trunc(3.14) = $TIS;

TEXT "2.5e3" AS STR;
PARSE[STR, STR] P;
TO_STRING[P, P] PPS;
PRINT parse 2.5e3 = $PPS;

THIS.DIE();
