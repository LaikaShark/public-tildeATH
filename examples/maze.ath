// Maze generator + solver. A W*H grid of cells is generated with the
// binary-tree algorithm (each cell carves a passage NORTH or EAST, chosen by
// an in-language LCG so the output is deterministic — no RNG seed needed), then
// solved from the top-left to the bottom-right with an iterative depth-first
// search whose stack *is* the current path (a perfect maze has exactly one
// route, so DFS finds it). There are no 2-D arrays: the grid is one string of
// cells, each char encoding two passage bits (north<<1 | east); visited-cells
// and the solution path are int bitmasks (shl/bor/band), so nothing mutates a
// string in place. The maze prints once plain, then again with the path as '*'.
//
//   athc examples/maze.ath -o maze
//   ./maze
//
// Cells are 8 wide by 6 tall (48 <= 63 bits, so the masks stay in an int64).

importf <add>    as ADD;
importf <sub>    as SUB;
importf <mul>    as MUL;
importf <div>    as DIV;
importf <mod>    as MOD;
importf <lt>     as LT;
importf <gt>     as GT;
importf <eq>     as EQ;
importf <ord>    as ORD;
importf <chr>    as CHR;
importf <shl>    as SHL;
importf <bor>    as BOR;
importf <band>   as BAND;
importf <concat> as CONCAT;

import number 0 as ZERO;
import number 1 as ONE;
import number 2 as TWO;
import number 8 as W;
import number 6 as H;
import number 48 as N;        // W*H cells
import number 7 as WM1;       // W-1
import number 5 as HM1;       // H-1
import number 47 as GOAL;     // N-1, bottom-right cell
import number 48 as C48;      // '0', the digit base for cell encoding

text "" as MT;
text "#" as HS;
text " " as SPC;
text "*" as STAR;

// --- LCG state and constants (glibc rand parameters) -----------------------
import number 1103515245 as LCGA;
import number 12345      as LCGC;
import number 2147483648 as LCGM;     // 2^31
import number 65536      as SH16;
import number 7          as X;        // seed

// --- generate the maze into CELLS ------------------------------------------
// Each cell's char is chr(48 + north*2 + east).
text "" as CELLS;
import number 0 as K;
LT [K, N] GENL;
~ATH(GENL) {
    DIV [K, W] r;  MOD [K, W] c;
    ADD [ZERO, ZERO] east;  ADD [ZERO, ZERO] north;
    EQ [r, ZERO] top;
    LT [c, WM1] notright;
    BRANCH(top) {
        // top row: carve east unless we are the rightmost cell
        BRANCH(notright) { ADD [ONE, ZERO] east; } ELSE { }
    } ELSE {
        BRANCH(notright) {
            // interior cell: flip an LCG coin -> north or east
            MUL [LCGA, X] t1;  ADD [t1, LCGC] t2;  MOD [t2, LCGM] X;
            DIV [X, SH16] hd;  MOD [hd, TWO] coin;
            EQ [coin, ZERO] cn;
            BRANCH(cn) { ADD [ONE, ZERO] north; } ELSE { ADD [ONE, ZERO] east; }
        } ELSE {
            // rightmost column (not top): carve north
            ADD [ONE, ZERO] north;
        }
    }
    MUL [north, TWO] nn;  ADD [nn, east] val;
    ADD [val, C48] vco;  CHR [vco, NULL] vch;
    CONCAT [CELLS, vch] CELLS;
    ADD [K, ONE] K;
    LT [K, N] GENL;
}

// --- render (used twice; reads CELLS + the PATH bitmask) -------------------
import number 0 as PATH;       // no path marked yet

text "generated:" as HDR1;
print $HDR1;

import number 13 as DRMAX;     // 2H+1 display rows
import number 17 as DCMAX;     // 2W+1 display cols
import number 0 as DR;
LT [DR, DRMAX] RR;
~ATH(RR) {
    text "" as LINE;
    import number 0 as DC;
    ADD [ZERO, ZERO] DC;
    LT [DC, DCMAX] CIN;
    ~ATH(CIN) {
        MOD [DR, TWO] drodd;  MOD [DC, TWO] dcodd;
        CONCAT [HS, MT] CHV;                       // default wall '#'
        EQ [drodd, ZERO] evenrow;
        BRANCH(evenrow) {
            EQ [dcodd, ZERO] evencol;
            BRANCH(evencol) { } ELSE {
                // horizontal wall slot above cell row r2, column c
                DIV [DR, TWO] r2;  SUB [DC, ONE] dcm;  DIV [dcm, TWO] c;
                EQ [r2, ZERO] r2top;  EQ [r2, H] r2bot;
                ADD [ZERO, ZERO] isb;
                BRANCH(r2top) { ADD [ONE, ZERO] isb; } ELSE { }
                BRANCH(r2bot) { ADD [ONE, ZERO] isb; } ELSE { }
                EQ [isb, ZERO] interiorH;
                BRANCH(interiorH) {
                    MUL [r2, W] base;  ADD [base, c] k;
                    CELLS[k] cc;  ORD [cc, NULL] co;  SUB [co, C48] cv;
                    DIV [cv, TWO] cnorth;
                    EQ [cnorth, ONE] openN;
                    BRANCH(openN) { CONCAT [SPC, MT] CHV; } ELSE { }
                } ELSE { }
            }
        } ELSE {
            EQ [dcodd, ZERO] evencol2;
            BRANCH(evencol2) {
                // vertical wall slot left of cell column c2, row r
                DIV [DC, TWO] c2;  SUB [DR, ONE] drm;  DIV [drm, TWO] r;
                EQ [c2, ZERO] c2l;  EQ [c2, W] c2r;
                ADD [ZERO, ZERO] isb2;
                BRANCH(c2l) { ADD [ONE, ZERO] isb2; } ELSE { }
                BRANCH(c2r) { ADD [ONE, ZERO] isb2; } ELSE { }
                EQ [isb2, ZERO] interiorV;
                BRANCH(interiorV) {
                    SUB [c2, ONE] cl;  MUL [r, W] base2;  ADD [base2, cl] k2;
                    CELLS[k2] cc2;  ORD [cc2, NULL] co2;  SUB [co2, C48] cv2;
                    MOD [cv2, TWO] ceast;
                    EQ [ceast, ONE] openE;
                    BRANCH(openE) { CONCAT [SPC, MT] CHV; } ELSE { }
                } ELSE { }
            } ELSE {
                // cell center: a space, or '*' if this cell is on the path
                SUB [DR, ONE] drm2;  DIV [drm2, TWO] rc;
                SUB [DC, ONE] dcm2;  DIV [dcm2, TWO] cc3;
                MUL [rc, W] baseC;  ADD [baseC, cc3] kc;
                CONCAT [SPC, MT] CHV;
                SHL [ONE, kc] mk;  BAND [PATH, mk] pk;
                GT [pk, ZERO] onpath;
                BRANCH(onpath) { CONCAT [STAR, MT] CHV; } ELSE { }
            }
        }
        CONCAT [LINE, CHV] LINE;
        ADD [DC, ONE] DC;
        LT [DC, DCMAX] CIN;
    }
    print $LINE;
    ADD [DR, ONE] DR;
    LT [DR, DRMAX] RR;
}

// --- solve: iterative DFS, the stack holds the current root->node path ------
import number 0 as VIS;        // visited bitmask
import number 0 as SP;         // stack depth
import number 0 as FOUND;
BIFURCATE NULL[jx0, STK];
// cell indices ride the stack as chr(index+1) atoms: ord wants a character
// *atom* (what S[I] yields), not the length-1 string chr() returns, so each
// pushed char is subscripted to an atom first; the +1 keeps cell 0 off NUL.
CHR [ONE, NULL] s0s;  s0s[ZERO] s0;  BIFURCATE [s0, STK] STK;   // push cell 0
ADD [ONE, ZERO] SP;
SHL [ONE, ZERO] vm0;  BOR [ZERO, vm0] VIS;       // mark cell 0 visited

LT [ZERO, SP] GO;
~ATH(GO) {
    BIFURCATE STK[TOPC, RST];  ORD [TOPC, NULL] CURENC;  SUB [CURENC, ONE] CUR;
    EQ [CUR, GOAL] atgoal;
    BRANCH(atgoal) { ADD [ONE, ZERO] FOUND; } ELSE {
        DIV [CUR, W] r;  MOD [CUR, W] c;
        CELLS[CUR] cc;  ORD [cc, NULL] co;  SUB [co, C48] cv;
        MOD [cv, TWO] east;  DIV [cv, TWO] north;
        ADD [ZERO, ZERO] MOVED;

        // East
        EQ [MOVED, ZERO] tE;
        BRANCH(tE) {
            LT [c, WM1] okE;
            BRANCH(okE) {
                EQ [east, ONE] opE;
                BRANCH(opE) {
                    ADD [CUR, ONE] nb;
                    SHL [ONE, nb] nm;  BAND [VIS, nm] vb;  EQ [vb, ZERO] freshE;
                    BRANCH(freshE) {
                        BOR [VIS, nm] VIS;
                        ADD [nb, ONE] nbe;  CHR [nbe, NULL] nchs;  nchs[ZERO] nch;  BIFURCATE [nch, STK] STK;
                        ADD [SP, ONE] SP;  ADD [ONE, ZERO] MOVED;
                    } ELSE { }
                } ELSE { }
            } ELSE { }
        } ELSE { }

        // West (open iff the west cell's east bit is set)
        EQ [MOVED, ZERO] tW;
        BRANCH(tW) {
            GT [c, ZERO] okW;
            BRANCH(okW) {
                SUB [CUR, ONE] wnb;
                CELLS[wnb] wcc;  ORD [wcc, NULL] wco;  SUB [wco, C48] wcv;
                MOD [wcv, TWO] weast;
                EQ [weast, ONE] opW;
                BRANCH(opW) {
                    SHL [ONE, wnb] wm;  BAND [VIS, wm] wvb;  EQ [wvb, ZERO] freshW;
                    BRANCH(freshW) {
                        BOR [VIS, wm] VIS;
                        ADD [wnb, ONE] wnbe;  CHR [wnbe, NULL] wchs;  wchs[ZERO] wch;  BIFURCATE [wch, STK] STK;
                        ADD [SP, ONE] SP;  ADD [ONE, ZERO] MOVED;
                    } ELSE { }
                } ELSE { }
            } ELSE { }
        } ELSE { }

        // North (open iff this cell's north bit is set)
        EQ [MOVED, ZERO] tN;
        BRANCH(tN) {
            GT [r, ZERO] okN;
            BRANCH(okN) {
                EQ [north, ONE] opN;
                BRANCH(opN) {
                    SUB [CUR, W] nnb;
                    SHL [ONE, nnb] nmm;  BAND [VIS, nmm] nvb;  EQ [nvb, ZERO] freshN;
                    BRANCH(freshN) {
                        BOR [VIS, nmm] VIS;
                        ADD [nnb, ONE] nnbe;  CHR [nnbe, NULL] nch2s;  nch2s[ZERO] nch2;  BIFURCATE [nch2, STK] STK;
                        ADD [SP, ONE] SP;  ADD [ONE, ZERO] MOVED;
                    } ELSE { }
                } ELSE { }
            } ELSE { }
        } ELSE { }

        // South (open iff the south cell's north bit is set)
        EQ [MOVED, ZERO] tS;
        BRANCH(tS) {
            LT [r, HM1] okS;
            BRANCH(okS) {
                ADD [CUR, W] snb;
                CELLS[snb] scc;  ORD [scc, NULL] sco;  SUB [sco, C48] scv;
                DIV [scv, TWO] snorth;
                EQ [snorth, ONE] opS;
                BRANCH(opS) {
                    SHL [ONE, snb] sm;  BAND [VIS, sm] svb;  EQ [svb, ZERO] freshS;
                    BRANCH(freshS) {
                        BOR [VIS, sm] VIS;
                        ADD [snb, ONE] snbe;  CHR [snbe, NULL] schs;  schs[ZERO] sch;  BIFURCATE [sch, STK] STK;
                        ADD [SP, ONE] SP;  ADD [ONE, ZERO] MOVED;
                    } ELSE { }
                } ELSE { }
            } ELSE { }
        } ELSE { }

        // dead end: backtrack
        EQ [MOVED, ZERO] deadend;
        BRANCH(deadend) {
            BIFURCATE STK[PTC, PRST];  CLONE PRST as STK;  SUB [SP, ONE] SP;
        } ELSE { }
    }

    // continue while not found and the stack is non-empty
    ADD [SP, ZERO] CONT;
    GT [FOUND, ZERO] isf;
    BRANCH(isf) { ADD [ZERO, ZERO] CONT; } ELSE { }
    LT [ZERO, CONT] GO;
}

// --- mark the path: consume the stack into the PATH bitmask -----------------
LT [ZERO, SP] MGO;
~ATH(MGO) {
    BIFURCATE STK[MC, MR];  ORD [MC, NULL] mienc;  SUB [mienc, ONE] mi;
    SHL [ONE, mi] mmk;  BOR [PATH, mmk] PATH;
    CLONE MR as STK;  SUB [SP, ONE] SP;
    LT [ZERO, SP] MGO;
}

// --- render again, now with the path marked --------------------------------
text "solved:" as HDR2;
print $HDR2;

ADD [ZERO, ZERO] DR;
LT [DR, DRMAX] RR2;
~ATH(RR2) {
    text "" as LINE2;
    ADD [ZERO, ZERO] DC;
    LT [DC, DCMAX] CIN2;
    ~ATH(CIN2) {
        MOD [DR, TWO] drodd;  MOD [DC, TWO] dcodd;
        CONCAT [HS, MT] CHV;
        EQ [drodd, ZERO] evenrow;
        BRANCH(evenrow) {
            EQ [dcodd, ZERO] evencol;
            BRANCH(evencol) { } ELSE {
                DIV [DR, TWO] r2;  SUB [DC, ONE] dcm;  DIV [dcm, TWO] c;
                EQ [r2, ZERO] r2top;  EQ [r2, H] r2bot;
                ADD [ZERO, ZERO] isb;
                BRANCH(r2top) { ADD [ONE, ZERO] isb; } ELSE { }
                BRANCH(r2bot) { ADD [ONE, ZERO] isb; } ELSE { }
                EQ [isb, ZERO] interiorH;
                BRANCH(interiorH) {
                    MUL [r2, W] base;  ADD [base, c] k;
                    CELLS[k] cc;  ORD [cc, NULL] co;  SUB [co, C48] cv;
                    DIV [cv, TWO] cnorth;
                    EQ [cnorth, ONE] openN;
                    BRANCH(openN) { CONCAT [SPC, MT] CHV; } ELSE { }
                } ELSE { }
            }
        } ELSE {
            EQ [dcodd, ZERO] evencol2;
            BRANCH(evencol2) {
                DIV [DC, TWO] c2;  SUB [DR, ONE] drm;  DIV [drm, TWO] r;
                EQ [c2, ZERO] c2l;  EQ [c2, W] c2r;
                ADD [ZERO, ZERO] isb2;
                BRANCH(c2l) { ADD [ONE, ZERO] isb2; } ELSE { }
                BRANCH(c2r) { ADD [ONE, ZERO] isb2; } ELSE { }
                EQ [isb2, ZERO] interiorV;
                BRANCH(interiorV) {
                    SUB [c2, ONE] cl;  MUL [r, W] base2;  ADD [base2, cl] k2;
                    CELLS[k2] cc2;  ORD [cc2, NULL] co2;  SUB [co2, C48] cv2;
                    MOD [cv2, TWO] ceast;
                    EQ [ceast, ONE] openE;
                    BRANCH(openE) { CONCAT [SPC, MT] CHV; } ELSE { }
                } ELSE { }
            } ELSE {
                SUB [DR, ONE] drm2;  DIV [drm2, TWO] rc;
                SUB [DC, ONE] dcm2;  DIV [dcm2, TWO] cc3;
                MUL [rc, W] baseC;  ADD [baseC, cc3] kc;
                CONCAT [SPC, MT] CHV;
                SHL [ONE, kc] mk;  BAND [PATH, mk] pk;
                GT [pk, ZERO] onpath;
                BRANCH(onpath) { CONCAT [STAR, MT] CHV; } ELSE { }
            }
        }
        CONCAT [LINE2, CHV] LINE2;
        ADD [DC, ONE] DC;
        LT [DC, DCMAX] CIN2;
    }
    print $LINE2;
    ADD [DR, ONE] DR;
    LT [DR, DRMAX] RR2;
}

THIS.DIE();
