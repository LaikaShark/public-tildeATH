// maze generator + solver. a W*H grid of cells is generated with the
// binary-tree algorithm (each cell carves a passage north or east, chosen by
// an in-language LCG so the output is deterministic (no rng seed), then
// solved from the top-left to the bottom-right with an iterative depth-first
// search whose stack is the current path (a perfect maze has exactly one
// route, so dfs finds it). there are no 2-D arrays: the grid is one string of
// cells, each char encoding two passage bits (north<<1 | east); visited-cells
// and the solution path are int bitmasks (shl/bor/band), so nothing mutates a
// string in place. the maze prints once plain, then again with the path as '*'.
//
//   athc examples/maze.ath -o maze
//   ./maze
//
// cells are 8 wide by 6 tall (48 <= 63 bits, so the masks stay in an int64).

IMPORTF <add> AS ADD;
IMPORTF <sub> AS SUB;
IMPORTF <mul> AS MUL;
IMPORTF <div> AS DIV;
IMPORTF <mod> AS MOD;
IMPORTF <lt> AS LT;
IMPORTF <gt> AS GT;
IMPORTF <eq> AS EQ;
IMPORTF <ord> AS ORD;
IMPORTF <chr> AS CHR;
IMPORTF <shl> AS SHL;
IMPORTF <bor> AS BOR;
IMPORTF <band> AS BAND;
IMPORTF <concat> AS CONCAT;

IMPORT NUMBER 0 AS ZERO;
IMPORT NUMBER 1 AS ONE;
IMPORT NUMBER 2 AS TWO;
IMPORT NUMBER 8 AS W;
IMPORT NUMBER 6 AS H;
IMPORT NUMBER 48 AS N; // W*H cells
IMPORT NUMBER 7 AS WM1; // W-1
IMPORT NUMBER 5 AS HM1; // H-1
IMPORT NUMBER 47 AS GOAL; // N-1, bottom-right cell
IMPORT NUMBER 48 AS C48; // '0', the digit base for cell encoding

TEXT "" AS MT;
TEXT "#" AS HS;
TEXT " " AS SPC;
TEXT "*" AS STAR;

// LCG state and constants (glibc rand parameters)
IMPORT NUMBER 1103515245 AS LCGA;
IMPORT NUMBER 12345 AS LCGC;
IMPORT NUMBER 2147483648 AS LCGM; // 2^31
IMPORT NUMBER 65536 AS SH16;
IMPORT NUMBER 7 AS X; // seed

// --- generate the maze into CELLS ------------------------------------------
// each cell's char is chr(48 + north*2 + east).
TEXT "" AS CELLS;
IMPORT NUMBER 0 AS K;
LT[K, N] GENL;
~ATH(GENL)
{
    DIV[K, W] R;
    MOD[K, W] C;
    ADD[ZERO, ZERO] EAST;
    ADD[ZERO, ZERO] NORTH;
    EQ[R, ZERO] TOP;
    LT[C, WM1] NOTRIGHT;
    BRANCH(TOP)
    {
        // top row: carve east unless we are the rightmost cell
        BRANCH(NOTRIGHT)
        {
            ADD[ONE, ZERO] EAST;
        }
    }
    ELSE
    {
        BRANCH(NOTRIGHT)
        {
            // interior cell: flip an LCG coin -> north or east
            MUL[LCGA, X] T1;
            ADD[T1, LCGC] T2;
            MOD[T2, LCGM] X;
            DIV[X, SH16] HD;
            MOD[HD, TWO] COIN;
            EQ[COIN, ZERO] CN;
            BRANCH(CN)
            {
                ADD[ONE, ZERO] NORTH;
            }
            ELSE
            {
                ADD[ONE, ZERO] EAST;
            }
        }
        ELSE
        {
            // rightmost column (not top): carve north
            ADD[ONE, ZERO] NORTH;
        }
    }
    MUL[NORTH, TWO] NN;
    ADD[NN, EAST] VAL;
    ADD[VAL, C48] VCO;
    CHR[VCO, NULL] VCH;
    CONCAT[CELLS, VCH] CELLS;
    ADD[K, ONE] K;
    LT[K, N] GENL;
}

// --- render (used twice; reads CELLS + the PATH bitmask) -------------------
IMPORT NUMBER 0 AS PATH; // no path marked yet

TEXT "generated:" AS HDR1;
PRINT $HDR1;

IMPORT NUMBER 13 AS DRMAX; // 2H+1 display rows
IMPORT NUMBER 17 AS DCMAX; // 2W+1 display cols
IMPORT NUMBER 0 AS DR;
LT[DR, DRMAX] RR;
~ATH(RR)
{
    TEXT "" AS LINE;
    ADD[ZERO, ZERO] DC;
    LT[DC, DCMAX] CIN;
    ~ATH(CIN)
    {
        MOD[DR, TWO] DRODD;
        MOD[DC, TWO] DCODD;
        CONCAT[HS, MT] CHV; // default wall '#'
        EQ[DRODD, ZERO] EVENROW;
        BRANCH(EVENROW)
        {
            EQ[DCODD, ZERO] EVENCOL;
            BRANCH(EVENCOL)
            {
            }
            ELSE
            {
                // horizontal wall slot above cell row R2, column C
                DIV[DR, TWO] R2;
                SUB[DC, ONE] DCM;
                DIV[DCM, TWO] C;
                EQ[R2, ZERO] R2TOP;
                EQ[R2, H] R2BOT;
                ADD[ZERO, ZERO] ISB;
                BRANCH(R2TOP)
                {
                    ADD[ONE, ZERO] ISB;
                }
                BRANCH(R2BOT)
                {
                    ADD[ONE, ZERO] ISB;
                }
                EQ[ISB, ZERO] INTERIORH;
                BRANCH(INTERIORH)
                {
                    MUL[R2, W] BASE;
                    ADD[BASE, C] KH;
                    CELLS[KH] CC;
                    ORD[CC, NULL] CO;
                    SUB[CO, C48] CV;
                    DIV[CV, TWO] CNORTH;
                    EQ[CNORTH, ONE] OPENN;
                    BRANCH(OPENN)
                    {
                        CONCAT[SPC, MT] CHV;
                    }
                }
            }
        }
        ELSE
        {
            EQ[DCODD, ZERO] EVENCOL2;
            BRANCH(EVENCOL2)
            {
                // vertical wall slot left of cell column C2, row R
                DIV[DC, TWO] C2;
                SUB[DR, ONE] DRM;
                DIV[DRM, TWO] R;
                EQ[C2, ZERO] C2L;
                EQ[C2, W] C2R;
                ADD[ZERO, ZERO] ISB2;
                BRANCH(C2L)
                {
                    ADD[ONE, ZERO] ISB2;
                }
                BRANCH(C2R)
                {
                    ADD[ONE, ZERO] ISB2;
                }
                EQ[ISB2, ZERO] INTERIORV;
                BRANCH(INTERIORV)
                {
                    SUB[C2, ONE] CL;
                    MUL[R, W] BASE2;
                    ADD[BASE2, CL] K2;
                    CELLS[K2] CC2;
                    ORD[CC2, NULL] CO2;
                    SUB[CO2, C48] CV2;
                    MOD[CV2, TWO] CEAST;
                    EQ[CEAST, ONE] OPENE;
                    BRANCH(OPENE)
                    {
                        CONCAT[SPC, MT] CHV;
                    }
                }
            }
            ELSE
            {
                // cell center: a space, or '*' if this cell is on the path
                SUB[DR, ONE] DRM2;
                DIV[DRM2, TWO] RC;
                SUB[DC, ONE] DCM2;
                DIV[DCM2, TWO] CC3;
                MUL[RC, W] BASEC;
                ADD[BASEC, CC3] KC;
                CONCAT[SPC, MT] CHV;
                SHL[ONE, KC] MK;
                BAND[PATH, MK] PK;
                GT[PK, ZERO] ONPATH;
                BRANCH(ONPATH)
                {
                    CONCAT[STAR, MT] CHV;
                }
            }
        }
        CONCAT[LINE, CHV] LINE;
        ADD[DC, ONE] DC;
        LT[DC, DCMAX] CIN;
    }
    PRINT $LINE;
    ADD[DR, ONE] DR;
    LT[DR, DRMAX] RR;
}

// --- solve: iterative DFS, the stack holds the current root->node path ------
IMPORT NUMBER 0 AS VIS; // visited bitmask
IMPORT NUMBER 0 AS SP; // stack depth
IMPORT NUMBER 0 AS FOUND;
BIFURCATE NULL[JX0, STK];
// cell indices ride the stack as chr(index+1) atoms: ord wants a character
// *atom* (what S[I] yields), not the length-1 string chr() returns, so each
// pushed char is subscripted to an atom first; the +1 keeps cell 0 off NUL.
CHR[ONE, NULL] S0S;
S0S[ZERO] S0;
BIFURCATE[S0, STK] STK; // push cell 0
ADD[ONE, ZERO] SP;
SHL[ONE, ZERO] VM0;
BOR[ZERO, VM0] VIS; // mark cell 0 visited

LT[ZERO, SP] GO;
~ATH(GO)
{
    BIFURCATE STK[TOPC, RST];
    ORD[TOPC, NULL] CURENC;
    SUB[CURENC, ONE] CUR;
    EQ[CUR, GOAL] ATGOAL;
    BRANCH(ATGOAL)
    {
        ADD[ONE, ZERO] FOUND;
    }
    ELSE
    {
        DIV[CUR, W] R;
        MOD[CUR, W] C;
        CELLS[CUR] CC;
        ORD[CC, NULL] CO;
        SUB[CO, C48] CV;
        MOD[CV, TWO] EAST;
        DIV[CV, TWO] NORTH;
        ADD[ZERO, ZERO] MOVED;

        // East
        EQ[MOVED, ZERO] TE;
        BRANCH(TE)
        {
            LT[C, WM1] OKE;
            BRANCH(OKE)
            {
                EQ[EAST, ONE] OPE;
                BRANCH(OPE)
                {
                    ADD[CUR, ONE] NB;
                    SHL[ONE, NB] NM;
                    BAND[VIS, NM] VB;
                    EQ[VB, ZERO] FRESHE;
                    BRANCH(FRESHE)
                    {
                        BOR[VIS, NM] VIS;
                        ADD[NB, ONE] NBE;
                        CHR[NBE, NULL] NCHS;
                        NCHS[ZERO] NCH;
                        BIFURCATE[NCH, STK] STK;
                        ADD[SP, ONE] SP;
                        ADD[ONE, ZERO] MOVED;
                    }
                }
            }
        }

        // West (open iff the west cell's east bit is set)
        EQ[MOVED, ZERO] TW;
        BRANCH(TW)
        {
            GT[C, ZERO] OKW;
            BRANCH(OKW)
            {
                SUB[CUR, ONE] WNB;
                CELLS[WNB] WCC;
                ORD[WCC, NULL] WCO;
                SUB[WCO, C48] WCV;
                MOD[WCV, TWO] WEAST;
                EQ[WEAST, ONE] OPW;
                BRANCH(OPW)
                {
                    SHL[ONE, WNB] WM;
                    BAND[VIS, WM] WVB;
                    EQ[WVB, ZERO] FRESHW;
                    BRANCH(FRESHW)
                    {
                        BOR[VIS, WM] VIS;
                        ADD[WNB, ONE] WNBE;
                        CHR[WNBE, NULL] WCHS;
                        WCHS[ZERO] WCH;
                        BIFURCATE[WCH, STK] STK;
                        ADD[SP, ONE] SP;
                        ADD[ONE, ZERO] MOVED;
                    }
                }
            }
        }

        // North (open iff this cell's north bit is set)
        EQ[MOVED, ZERO] TN;
        BRANCH(TN)
        {
            GT[R, ZERO] OKN;
            BRANCH(OKN)
            {
                EQ[NORTH, ONE] OPN;
                BRANCH(OPN)
                {
                    SUB[CUR, W] NNB;
                    SHL[ONE, NNB] NMM;
                    BAND[VIS, NMM] NVB;
                    EQ[NVB, ZERO] FRESHN;
                    BRANCH(FRESHN)
                    {
                        BOR[VIS, NMM] VIS;
                        ADD[NNB, ONE] NNBE;
                        CHR[NNBE, NULL] NCH2S;
                        NCH2S[ZERO] NCH2;
                        BIFURCATE[NCH2, STK] STK;
                        ADD[SP, ONE] SP;
                        ADD[ONE, ZERO] MOVED;
                    }
                }
            }
        }

        // South (open iff the south cell's north bit is set)
        EQ[MOVED, ZERO] TS;
        BRANCH(TS)
        {
            LT[R, HM1] OKS;
            BRANCH(OKS)
            {
                ADD[CUR, W] SNB;
                CELLS[SNB] SCC;
                ORD[SCC, NULL] SCO;
                SUB[SCO, C48] SCV;
                DIV[SCV, TWO] SNORTH;
                EQ[SNORTH, ONE] OPS;
                BRANCH(OPS)
                {
                    SHL[ONE, SNB] SM;
                    BAND[VIS, SM] SVB;
                    EQ[SVB, ZERO] FRESHS;
                    BRANCH(FRESHS)
                    {
                        BOR[VIS, SM] VIS;
                        ADD[SNB, ONE] SNBE;
                        CHR[SNBE, NULL] SCHS;
                        SCHS[ZERO] SCH;
                        BIFURCATE[SCH, STK] STK;
                        ADD[SP, ONE] SP;
                        ADD[ONE, ZERO] MOVED;
                    }
                }
            }
        }

        // dead end: backtrack
        EQ[MOVED, ZERO] DEADEND;
        BRANCH(DEADEND)
        {
            BIFURCATE STK[PTC, PRST];
            CLONE PRST AS STK;
            SUB[SP, ONE] SP;
        }
    }

    // continue while not found and the stack is non-empty
    ADD[SP, ZERO] CONT;
    GT[FOUND, ZERO] ISF;
    BRANCH(ISF)
    {
        ADD[ZERO, ZERO] CONT;
    }
    LT[ZERO, CONT] GO;
}

// --- mark the path: consume the stack into the PATH bitmask -----------------
LT[ZERO, SP] MGO;
~ATH(MGO)
{
    BIFURCATE STK[MC, MR];
    ORD[MC, NULL] MIENC;
    SUB[MIENC, ONE] MI;
    SHL[ONE, MI] MMK;
    BOR[PATH, MMK] PATH;
    CLONE MR AS STK;
    SUB[SP, ONE] SP;
    LT[ZERO, SP] MGO;
}

// --- render again, now with the path marked --------------------------------
TEXT "solved:" AS HDR2;
PRINT $HDR2;

ADD[ZERO, ZERO] DR;
LT[DR, DRMAX] RR2;
~ATH(RR2)
{
    TEXT "" AS LINE2;
    ADD[ZERO, ZERO] DC;
    LT[DC, DCMAX] CIN2;
    ~ATH(CIN2)
    {
        MOD[DR, TWO] DRODD;
        MOD[DC, TWO] DCODD;
        CONCAT[HS, MT] CHV;
        EQ[DRODD, ZERO] EVENROW;
        BRANCH(EVENROW)
        {
            EQ[DCODD, ZERO] EVENCOL;
            BRANCH(EVENCOL)
            {
            }
            ELSE
            {
                DIV[DR, TWO] R2;
                SUB[DC, ONE] DCM;
                DIV[DCM, TWO] C;
                EQ[R2, ZERO] R2TOP;
                EQ[R2, H] R2BOT;
                ADD[ZERO, ZERO] ISB;
                BRANCH(R2TOP)
                {
                    ADD[ONE, ZERO] ISB;
                }
                BRANCH(R2BOT)
                {
                    ADD[ONE, ZERO] ISB;
                }
                EQ[ISB, ZERO] INTERIORH;
                BRANCH(INTERIORH)
                {
                    MUL[R2, W] BASE;
                    ADD[BASE, C] KH;
                    CELLS[KH] CC;
                    ORD[CC, NULL] CO;
                    SUB[CO, C48] CV;
                    DIV[CV, TWO] CNORTH;
                    EQ[CNORTH, ONE] OPENN;
                    BRANCH(OPENN)
                    {
                        CONCAT[SPC, MT] CHV;
                    }
                }
            }
        }
        ELSE
        {
            EQ[DCODD, ZERO] EVENCOL2;
            BRANCH(EVENCOL2)
            {
                DIV[DC, TWO] C2;
                SUB[DR, ONE] DRM;
                DIV[DRM, TWO] R;
                EQ[C2, ZERO] C2L;
                EQ[C2, W] C2R;
                ADD[ZERO, ZERO] ISB2;
                BRANCH(C2L)
                {
                    ADD[ONE, ZERO] ISB2;
                }
                BRANCH(C2R)
                {
                    ADD[ONE, ZERO] ISB2;
                }
                EQ[ISB2, ZERO] INTERIORV;
                BRANCH(INTERIORV)
                {
                    SUB[C2, ONE] CL;
                    MUL[R, W] BASE2;
                    ADD[BASE2, CL] K2;
                    CELLS[K2] CC2;
                    ORD[CC2, NULL] CO2;
                    SUB[CO2, C48] CV2;
                    MOD[CV2, TWO] CEAST;
                    EQ[CEAST, ONE] OPENE;
                    BRANCH(OPENE)
                    {
                        CONCAT[SPC, MT] CHV;
                    }
                }
            }
            ELSE
            {
                SUB[DR, ONE] DRM2;
                DIV[DRM2, TWO] RC;
                SUB[DC, ONE] DCM2;
                DIV[DCM2, TWO] CC3;
                MUL[RC, W] BASEC;
                ADD[BASEC, CC3] KC;
                CONCAT[SPC, MT] CHV;
                SHL[ONE, KC] MK;
                BAND[PATH, MK] PK;
                GT[PK, ZERO] ONPATH;
                BRANCH(ONPATH)
                {
                    CONCAT[STAR, MT] CHV;
                }
            }
        }
        CONCAT[LINE2, CHV] LINE2;
        ADD[DC, ONE] DC;
        LT[DC, DCMAX] CIN2;
    }
    PRINT $LINE2;
    ADD[DR, ONE] DR;
    LT[DR, DRMAX] RR2;
}

THIS.DIE();
