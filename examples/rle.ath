// Run-length encoding and decoding. Encode counts maximal runs of equal
// characters ("aaabbbbc" -> "3a4b1c"); decode parses each <count><char>
// group and expands it. Prints the encoding and the round-tripped string.
// Showcases nested string walks, an out-of-range subscript yielding a dead
// object (used as the natural inner-loop terminator), digit parsing, and
// `loop N` for the expansion.
//
//   athc examples/rle.ath -o rle
//   echo 'aaabbbbc' | ./rle
//   # expected:
//   # encoded: 3a4b1c
//   # decoded: aaabbbbc

IMPORTF <add> AS ADD;
IMPORTF <mul> AS MUL;
IMPORTF <sub> AS SUB;
IMPORTF <lt> AS LT;
IMPORTF <le> AS LE;
IMPORTF <ge> AS GE;
IMPORTF <eq> AS EQ;
IMPORTF <and> AS AND;
IMPORTF <length> AS LENGTH;
IMPORTF <ord> AS ORD;
IMPORTF <chr> AS CHR;
IMPORTF <concat> AS CONCAT;
IMPORTF <to_string> AS TO_STRING;

INPUT S;
IMPORT NUMBER 0 AS ZERO;
IMPORT NUMBER 1 AS ONE;
IMPORT NUMBER 10 AS TEN;
IMPORT NUMBER 48 AS D0;      // '0'
IMPORT NUMBER 57 AS D9;      // '9'

// --- encode ---------------------------------------------------------------
LENGTH[S, NULL] L;
TEXT "" AS ENC;
IMPORT NUMBER 0 AS I;
LT[I, L] EGO;
~ATH(EGO)
{
    S[I] CH;
    ORD[CH, NULL] C;
    ADD[ONE, ZERO] RUN;             // RUN := 1
    ADD[I, ONE] J;
    S[J] CHJ;
    ORD[CHJ, NULL] CJ;
    EQ[CJ, C] JIN;   // dead when J out of range
    ~ATH(JIN)
    {
        ADD[RUN, ONE] RUN;
        ADD[J, ONE] J;
        S[J] CHK;
        ORD[CHK, NULL] CK;
        EQ[CK, C] JIN;
    }
    TO_STRING[RUN, NULL] RUNS;
    CHR[C, NULL] CHS;
    CONCAT[ENC, RUNS] ENC;
    CONCAT[ENC, CHS] ENC;
    ADD[J, ZERO] I;                 // I := J (start of next run)
    LT[I, L] EGO;
}
PRINT encoded: $ENC;

// --- decode ---------------------------------------------------------------
LENGTH[ENC, NULL] EL;
TEXT "" AS DEC;
IMPORT NUMBER 0 AS K;
LT[K, EL] DGO;
~ATH(DGO)
{
    // read a run of digits into NUM
    ADD[ZERO, ZERO] NUM;
    ENC[K] DCH;
    ORD[DCH, NULL] DC;
    GE[DC, D0] G;
    LE[DC, D9] L;
    AND[G, L] ISDIG;
    ~ATH(ISDIG)
    {
        SUB[DC, D0] DV;
        MUL[NUM, TEN] NUM;
        ADD[NUM, DV] NUM;       // NUM := NUM*10 + digit
        ADD[K, ONE] K;
        ENC[K] DCH;
        ORD[DCH, NULL] DC;
        GE[DC, D0] G2;
        LE[DC, D9] L2;
        AND[G2, L2] ISDIG;
    }
    // the next character is the run char; emit it NUM times
    CHR[DC, NULL] RUNCH;
    LOOP NUM
    {
        CONCAT[DEC, RUNCH] DEC;
    }
    ADD[K, ONE] K;
    LT[K, EL] DGO;
}
PRINT decoded: $DEC;
THIS.DIE();
