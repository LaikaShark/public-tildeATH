// Tier 3i demo: repeat, reverse, pad, and the ord/chr atom bridge.
//
// Reads one line S and prints, one per line:
//   1. S repeated 3 times
//   2. S reversed
//   3. S left-padded with spaces to width 5
//   4. S right-padded with spaces to width 5
//   5. the code point of S's first character
//   6. that code point mapped back to a length-1 string (CHR is ORD's
//      inverse)
//
// Try:
//   athc examples/string_build/main.ath -o sb
//   printf 'ab\n' | ./sb
//   # ababab / ba / "   ab" / "ab   " / 97 / a

IMPORTF <repeat>    AS REPEAT;
IMPORTF <reverse>   AS REVERSE;
IMPORTF <pad_left>  AS PAD_LEFT;
IMPORTF <pad_right> AS PAD_RIGHT;
IMPORTF <ord>       AS ORD;
IMPORTF <chr>       AS CHR;
IMPORTF <to_string> AS TO_STRING;

INPUT S;

IMPORT NUMBER 3 AS N3;
REPEAT[S, N3] REP;
PRINT $REP;

REVERSE[S, NULL] REV;
PRINT $REV;

IMPORT NUMBER 5 AS N5;
PAD_LEFT[S, N5] PL;
PRINT $PL;
PAD_RIGHT[S, N5] PR;
PRINT $PR;

IMPORT NUMBER 0 AS I0;
S[I0] H;
ORD[H, NULL] OC;
TO_STRING[OC, NULL] OCS;
PRINT $OCS;
CHR[OC, NULL] BACK;
PRINT $BACK;

THIS.DIE();
