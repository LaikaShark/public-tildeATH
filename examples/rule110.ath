// Rule 110, the (Turing-complete) elementary cellular automaton. Each row is
// a string of '#'/'.'; the next row's cell i comes from the 3-cell
// neighborhood (i-1, i, i+1) via Rule 110's table, encoded as bit p of 110.
// Boundary cells need no special case: an out-of-range subscript yields a
// dead verdict, i.e. value 0. Showcases strings-as-arrays, `loop`, and a
// verdict→{0,1} conversion via BRANCH.
//
//   athc examples/rule110.ath -o rule110
//   ./rule110
//   # expected (16 rows, a single seed at the right growing left):
//   # ...............................#
//   # ..............................##
//   # .............................###
//   # ............................##.#
//   # ...........................#####
//   # ..........................##...#
//   # .........................###..##
//   # ........................##.#.###
//   # .......................#######.#
//   # ......................##.....###
//   # .....................###....##.#
//   # ....................##.#...#####
//   # ...................#####..##...#
//   # ..................##...#.###..##
//   # .................###..####.#.###
//   # ................##.#.##..#####.#

IMPORTF <add> AS ADD;
IMPORTF <sub> AS SUB;
IMPORTF <mul> AS MUL;
IMPORTF <lt> AS LT;
IMPORTF <eq> AS EQ;
IMPORTF <shr> AS SHR;
IMPORTF <band> AS BAND;
IMPORTF <ord> AS ORD;
IMPORTF <concat> AS CONCAT;

IMPORT NUMBER 0 AS ZERO;
IMPORT NUMBER 1 AS ONE;
IMPORT NUMBER 2 AS TWO;
IMPORT NUMBER 4 AS FOUR;
IMPORT NUMBER 35 AS HASH;     // '#'
IMPORT NUMBER 110 AS R110;
IMPORT NUMBER 32 AS W;        // row width
IMPORT NUMBER 16 AS GENS;

TEXT "#" AS HS;
TEXT "." AS DS;
TEXT "" AS MT;
TEXT "...............................#" AS ROW;   // 31 dots + '#'

IMPORT NUMBER 0 AS I;
TEXT "" AS NEXT;

LOOP GENS
{
    PRINT $ROW;

    // build NEXT from ROW, cell by cell
    TEXT "" AS N2;            // (rebind a fresh empty accumulator)
    ADD[ZERO, ZERO] I;
    LT[I, W] CIN;
    ~ATH(CIN)
    {
        // neighborhood values (out-of-range -> dead verdict -> 0)
        SUB[I, ONE] IM;
        ROW[IM] CL;
        ORD[CL, NULL] OL;
        EQ[OL, HASH] LH;
        ROW[I] CS;
        ORD[CS, NULL] OS;
        EQ[OS, HASH] SH;
        ADD[I, ONE] IP;
        ROW[IP] CR;
        ORD[CR, NULL] ORR;
        EQ[ORR, HASH] RH;

        ADD[ZERO, ZERO] LV;
        BRANCH(LH)
        {
            ADD[ONE, ZERO] LV;
        }
        ADD[ZERO, ZERO] SV;
        BRANCH(SH)
        {
            ADD[ONE, ZERO] SV;
        }
        ADD[ZERO, ZERO] RV;
        BRANCH(RH)
        {
            ADD[ONE, ZERO] RV;
        }

        MUL[LV, FOUR] A;
        MUL[SV, TWO] B;
        ADD[A, B] AB;
        ADD[AB, RV] P;
        SHR[R110, P] T;
        BAND[T, ONE] NB;          // next bit = (110 >> p) & 1

        EQ[NB, ONE] ON;
        BRANCH(ON)
        {
            CONCAT[N2, HS] N2;
        }
        ELSE
        {
            CONCAT[N2, DS] N2;
        }

        ADD[I, ONE] I;
        LT[I, W] CIN;
    }
    CONCAT[N2, MT] ROW;       // ROW := NEXT
}
THIS.DIE();
