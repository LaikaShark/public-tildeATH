// a brainfuck interpreter -- proof that ~ATH is turing-complete. the byte tape
// is a string of cells (mutated by rebuilding the string, since strings are
// immutable); the data pointer and program counter are ints; the main loop
// fetches program[pc] and dispatches the eight commands. `[` and `]` jump by
// scanning for the matching bracket with a depth counter. output is collected
// into a string and printed at the end (print adds one trailing newline).
//
// the embedded program prints "Hello World!".
//
//   athc examples/brainfuck.ath -o bf
//   ./bf
//   # expected:
//   # Hello World!

IMPORTF <add> AS ADD;
IMPORTF <sub> AS SUB;
IMPORTF <mod> AS MOD;
IMPORTF <lt> AS LT;
IMPORTF <gt> AS GT;
IMPORTF <eq> AS EQ;
IMPORTF <length> AS LENGTH;
IMPORTF <ord> AS ORD;
IMPORTF <chr> AS CHR;
IMPORTF <concat> AS CONCAT;

// hello-world brainfuck (no trailing newline)
TEXT "++++++++[>++++[>++>+++>+++>+<<<<-]>+>+>->>+[<]<-]>>.>---.+++++++..+++.>>.<-.<.+++.------.--------.>>+." AS PROG;

IMPORT NUMBER 0 AS ZERO;
IMPORT NUMBER 1 AS ONE;
IMPORT NUMBER 256 AS C256;
IMPORT NUMBER 255 AS C255;
IMPORT NUMBER 62 AS GTC; // >
IMPORT NUMBER 60 AS LTC; // <
IMPORT NUMBER 43 AS PLUSC; // +
IMPORT NUMBER 45 AS MINUSC; // -
IMPORT NUMBER 46 AS DOTC; // .
IMPORT NUMBER 91 AS LBC; // [
IMPORT NUMBER 93 AS RBC; // ]
IMPORT NUMBER 30 AS TLEN; // tape length

// tape := TLEN zero cells; OUT := ""
LENGTH[PROG, NULL] PLEN;
CHR[ZERO, NULL] ZCH;
TEXT "" AS TAPE;
LOOP TLEN
{
    CONCAT[TAPE, ZCH] TAPE;
}
TEXT "" AS OUT;

IMPORT NUMBER 0 AS PTR;
IMPORT NUMBER 0 AS PC;
IMPORT NUMBER 0 AS WFLAG; // flag: this command writes a new cell value
IMPORT NUMBER 0 AS NEWVAL;
IMPORT NUMBER 0 AS RJ; // tape-rebuild countdown index (reset each write)

LT[PC, PLEN] RUN;
~ATH(RUN)
{
    PROG[PC] CMDCH;
    ORD[CMDCH, NULL] OP;
    TAPE[PTR] CELLCH;
    ORD[CELLCH, NULL] CELL;
    ADD[ZERO, ZERO] WFLAG;

    EQ[OP, GTC] ISGT;
    BRANCH(ISGT)
    {
        ADD[PTR, ONE] PTR;
    }
    ELSE
    {
        EQ[OP, LTC] ISLT;
        BRANCH(ISLT)
        {
            SUB[PTR, ONE] PTR;
        }
        ELSE
        {
            EQ[OP, PLUSC] ISPLUS;
            BRANCH(ISPLUS)
            {
                ADD[CELL, ONE] V;
                MOD[V, C256] NEWVAL;
                ADD[ONE, ZERO] WFLAG;
            }
            ELSE
            {
                EQ[OP, MINUSC] ISMINUS;
                BRANCH(ISMINUS)
                {
                    ADD[CELL, C255] V;
                    MOD[V, C256] NEWVAL;
                    ADD[ONE, ZERO] WFLAG;
                }
                ELSE
                {
                    EQ[OP, DOTC] ISDOT;
                    BRANCH(ISDOT)
                    {
                        CHR[CELL, NULL] OCH;
                        CONCAT[OUT, OCH] OUT;
                    }
                    ELSE
                    {
                        EQ[OP, LBC] ISLB;
                        BRANCH(ISLB)
                        {
                            EQ[CELL, ZERO] ISZERO;
                            BRANCH(ISZERO)
                            {
                                // jump forward past the matching ']'
                                ADD[ONE, ZERO] DEPTH;
                                ADD[PC, ONE] SI;
                                GT[DEPTH, ZERO] SCAN;
                                ~ATH(SCAN)
                                {
                                    PROG[SI] SC;
                                    ORD[SC, NULL] SO;
                                    EQ[SO, LBC] SL;
                                    BRANCH(SL)
                                    {
                                        ADD[DEPTH, ONE] DEPTH;
                                    }
                                    EQ[SO, RBC] SR;
                                    BRANCH(SR)
                                    {
                                        SUB[DEPTH, ONE] DEPTH;
                                    }
                                    ADD[SI, ONE] SI;
                                    GT[DEPTH, ZERO] SCAN;
                                }
                                // PC := matching ']' (++ moves past)
                                SUB[SI, ONE] PC;
                            }
                        }
                        ELSE
                        {
                            EQ[OP, RBC] ISRB;
                            BRANCH(ISRB)
                            {
                                GT[CELL, ZERO] NONZERO;
                                BRANCH(NONZERO)
                                {
                                    // jump back to the matching '['
                                    ADD[ONE, ZERO] DEPTH;
                                    SUB[PC, ONE] SI;
                                    GT[DEPTH, ZERO] SCAN;
                                    ~ATH(SCAN)
                                    {
                                        PROG[SI] SC;
                                        ORD[SC, NULL] SO;
                                        EQ[SO, RBC] SR;
                                        BRANCH(SR)
                                        {
                                            ADD[DEPTH, ONE] DEPTH;
                                        }
                                        EQ[SO, LBC] SL;
                                        BRANCH(SL)
                                        {
                                            SUB[DEPTH, ONE] DEPTH;
                                        }
                                        SUB[SI, ONE] SI;
                                        GT[DEPTH, ZERO] SCAN;
                                    }
                                    // PC := matching '[' (++ re-enters body)
                                    ADD[SI, ONE] PC;
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // commit a cell write if + or - asked for one. rebuild the tape cons by
    // cons (right to left) with plain compose, which installs no lifetime
    // deps -- and CLONE each char atom to strip the subscript snapshot's deps.
    // without this, repeated slice/concat rebuilds pile up dependency chains
    // that ath_is_alive walks recursively, blowing up to quadratic/exponential.
    EQ[WFLAG, ONE] DOWRITE;
    BRANCH(DOWRITE)
    {
        CHR[NEWVAL, NULL] NCHS;
        NCHS[ZERO] NA0;
        CLONE NA0 AS NEWATOM;
        BIFURCATE NULL[JX, ACC];
        SUB[TLEN, ONE] TM;
        ADD[ZERO, ZERO] RJ;
        LT[RJ, TLEN] RGO;
        ~ATH(RGO)
        {
            SUB[TM, RJ] IDX;
            EQ[IDX, PTR] ISHERE;
            BRANCH(ISHERE)
            {
                BIFURCATE[NEWATOM, ACC] ACC;
            }
            ELSE
            {
                TAPE[IDX] OA;
                CLONE OA AS CA;
                BIFURCATE[CA, ACC] ACC;
            }
            ADD[RJ, ONE] RJ;
            LT[RJ, TLEN] RGO;
        }
        BIFURCATE ACC[AH, AT];
        BIFURCATE[AH, AT] TAPE;
    }

    ADD[PC, ONE] PC;
    LT[PC, PLEN] RUN;
}

PRINT $OUT;
THIS.DIE();
