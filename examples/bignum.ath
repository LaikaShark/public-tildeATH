// Demonstrates arbitrary-precision bignums (§4.8.7). An integer literal
// beyond int64 is a bignum; arithmetic is exact and never overflows.
//
//   athc examples/bignum.ath -o bn
//   ./bn
//   # expected:
//   # 99999999999999999999 + 1 = 100000000000000000000
//   # square = 9999999999999999999800000000000000000001
//   # square / big = 99999999999999999999
//   # big - (big-1) = 1

IMPORTF <add> AS ADD;
IMPORTF <sub> AS SUB;
IMPORTF <mul> AS MUL;
IMPORTF <div> AS DIV;

IMPORT NUMBER 99999999999999999999 AS BIG;
IMPORT NUMBER 99999999999999999998 AS BIGM1;
IMPORT NUMBER 1 AS ONE;

ADD[BIG, ONE] PLUS;
PRINT 99999999999999999999 + 1 = $PLUS;
MUL[BIG, BIG] SQ;
PRINT square = $SQ;
DIV[SQ, BIG] BACK;
PRINT square / big = $BACK;
SUB[BIG, BIGM1] DIFF;
PRINT big - (big-1) = $DIFF;

THIS.DIE();
