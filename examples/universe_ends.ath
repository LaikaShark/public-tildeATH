// The canonical ~ATH conceit: do something when the universe ends. We
// import the universe (an eternal-alive object), then end it ourselves and
// observe that — death being one-way — execution simply carries on past it.
//
//   athc examples/universe_ends.ath -o ue
//   ./ue
//   # expected:
//   # the universe is alive; we wait.
//   # the universe has ended.
//   # and yet, the program continues.

IMPORT UNIVERSE U;

// A ~ATH(!U) loop runs while U is *dead*. U is alive, so it is skipped...
~ATH(!U)
{
    PRINT this cannot print while the universe lives;
    BIFURCATE[NULL, NULL] U;
}
PRINT the universe is alive\; we wait.;

// ...until we end it. Now the inverted loop's body would run, so we guard
// it to fire exactly once.
U.DIE();
~ATH(!U)
{
    PRINT the universe has ended.;
    BIFURCATE[NULL, NULL] U;     // revive U to break out (one pass)
}

PRINT and yet, the program continues.;
THIS.DIE();
