// Tier 4b: numeric second-wave builtins — pow, gcd, min/max, bitwise,
// shift, sign, and clamp (pair-packed bounds).
//
//   athc examples/numeric_ops/main.ath -o no && ./no
//   # 1024 / 6 / 12 / 18 / 6 / 48 / -1 / 18

IMPORTF <pow>       AS POW;
IMPORTF <gcd>       AS GCD;
IMPORTF <min>       AS MIN;
IMPORTF <max>       AS MAX;
IMPORTF <bxor>      AS BXOR;
IMPORTF <shl>       AS SHL;
IMPORTF <neg>       AS NEG;
IMPORTF <sign>      AS SIGN;
IMPORTF <clamp>     AS CLAMP;
IMPORTF <to_string> AS TO_STRING;
IMPORTF <entangle>  AS ENTANGLE;

IMPORT NUMBER 2 AS TWO;
IMPORT NUMBER 10 AS TEN;
IMPORT NUMBER 12 AS N12;
IMPORT NUMBER 18 AS N18;
IMPORT NUMBER 100 AS N100;
IMPORT NUMBER 0 AS ZERO;

POW[TWO, TEN] A;
TO_STRING[A, NULL] AOUT;
PRINT $AOUT;
GCD[N12, N18] B;
TO_STRING[B, NULL] BS;
PRINT $BS;
MIN[N12, N18] C;
TO_STRING[C, NULL] CS;
PRINT $CS;
MAX[N12, N18] D;
TO_STRING[D, NULL] DS;
PRINT $DS;
BXOR[N12, TEN] E;
TO_STRING[E, NULL] ES;
PRINT $ES;
SHL[N12, TWO] F;
TO_STRING[F, NULL] FS;
PRINT $FS;
NEG[TEN, NULL] G;
SIGN[G, NULL] H;
TO_STRING[H, NULL] HS;
PRINT $HS;
ENTANGLE[ZERO, N18] LH;
CLAMP[N100, LH] I;
TO_STRING[I, NULL] IS;
PRINT $IS;

THIS.DIE();
