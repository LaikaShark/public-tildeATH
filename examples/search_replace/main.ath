// Tier 3c demo: FIND + REPLACE_ALL.
//
// Reads three lines from stdin:
//   1. a haystack string
//   2. a needle to search for
//   3. a replacement string
//
// Prints the index of the first match (or "not found"), then the
// string with every occurrence of the needle replaced.
//
// Try:
//   athc examples/search_replace/main.ath -o sr
//   printf 'hello world hello\nhello\nhi\n' | ./sr
//   # 0
//   # hi world hi

importf <find>        as FIND;
importf <replace_all> as REPLACE_ALL;
importf <to_string>   as TO_STRING;
importf <entangle>    as ENTANGLE;

INPUT HAY;
INPUT NEEDLE;
INPUT REPL;

// Search: report the position of the first match (or "not found").
FIND [HAY, NEEDLE] IDX;
CLONE IDX as IDX_CHECK;
BRANCH(IDX_CHECK) {
    TO_STRING [IDX, NULL] S;
    PRINT2 S;
} ELSE {
    print not found;
}

// Replace: pack (NEEDLE, REPL) with dep propagation, then call. ENTANGLE
// ensures that if NEEDLE or REPL dies after the call, the REPLACE_ALL
// result observes the death and becomes dead at the next observation.
ENTANGLE [NEEDLE, REPL] PAIR;
REPLACE_ALL [HAY, PAIR] R;
PRINT2 R;

THIS.DIE();
