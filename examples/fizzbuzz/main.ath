// Three mutually-recursive functions cycle: FIZZ calls BUZZ, BUZZ calls
// FIZZBUZZ, FIZZBUZZ calls FIZZ. Starting from FIZZ with counter 6,
// the expected sequence of prints is:
//
//   fizz, buzz, fizzbuzz, fizz, buzz, fizzbuzz.

importf "fizz.ath"     as FIZZ;
importf "buzz.ath"     as BUZZ;
importf "fizzbuzz.ath" as FIZZBUZZ;

import sentinel S;
BIFURCATE [NULL, S] N1;
BIFURCATE [S, N1] N2;
BIFURCATE [S, N2] N3;
BIFURCATE [S, N3] N4;
BIFURCATE [S, N4] N5;
BIFURCATE [S, N5] N6;

FIZZ N6 [X, Y];
THIS.DIE();
