// Exercises OR's disjunctive dep walk in ath_is_alive: the result R
// stays alive as long as at least one of its operands is alive, even
// after one operand has been killed independently.
//
//   athc examples/or_dynamic/main.ath -o ord
//   ./ord
//   # expected:
//   # both alive
//   # one alive
//   # both dead
//
// CLONE is used to inspect R without consuming the original. The clone
// captures R's currently observable liveness at clone time (refreshed
// via ath_observe), so the snapshot reflects the dep walk's result
// rather than R's possibly-stale raw alive bit.

IMPORTF <gt> AS GT;
IMPORTF <or> AS OR;

IMPORT NUMBER 1 AS ONE;
IMPORT NUMBER 0 AS ZERO;

GT[ONE, ZERO] V1;
GT[ONE, ZERO] V2;
OR[V1, V2] R;

CLONE R AS R1;
BRANCH(R1)
{
    PRINT both alive;
}
ELSE
{
    PRINT both fail;
}

V1.DIE();
CLONE R AS R2;
BRANCH(R2)
{
    PRINT one alive;
}
ELSE
{
    PRINT one fail;
}

V2.DIE();
CLONE R AS R3;
BRANCH(R3)
{
    PRINT both fail;
}
ELSE
{
    PRINT both dead;
}

THIS.DIE();
