// Tier 4f: the `loop N { body }` count loop (§4.4.26). Runs the body
// N.value times; a non-positive count runs it zero times. Loops nest.
//
//   athc examples/repeat_loop/main.ath -o rl && ./rl
//   # row / dot / dot / row / dot / dot / done

IMPORT NUMBER 2 AS TWO;
IMPORT NUMBER 0 AS ZERO;

LOOP TWO
{
    PRINT row;
    LOOP TWO
    {
        PRINT dot;
    }
}
LOOP ZERO
{
    PRINT skipped;
}
PRINT done;

THIS.DIE();
