// Tier 4c: generic cons-list operations over a number list.
//
// A list is a right-nested cons-list, built here with BIFURCATE:
// [4, 3, 8]. We then sum/multiply/extremum it, test membership, and
// slice it with TAKE / DROP — none of which is string-specific.
//
//   athc examples/list_ops/main.ath -o lo && ./lo
//   # 15 / 96 / 8 / 3 / has 3 / no 99 / 2 / 7 / 8

importf <sum>       as SUM;
importf <product>   as PRODUCT;
importf <maximum>   as MAXIMUM;
importf <minimum>   as MINIMUM;
importf <member>    as MEMBER;
importf <take>      as TAKE;
importf <drop>      as DROP;
importf <length>    as LENGTH;
importf <to_string> as TO_STRING;

import number 4 as N4;
import number 3 as N3;
import number 8 as N8;
import number 99 as N99;
import number 2 as N2;

// Build [4, 3, 8] head-first.
BIFURCATE [N8, NULL] L1;
BIFURCATE [N3, L1] L2;
BIFURCATE [N4, L2] LIST;

SUM [LIST, NULL] S;     TO_STRING [S, NULL] SS;   PRINT2 SS;
PRODUCT [LIST, NULL] P; TO_STRING [P, NULL] PS;   PRINT2 PS;
MAXIMUM [LIST, NULL] MX; TO_STRING [MX, NULL] MXS; PRINT2 MXS;
MINIMUM [LIST, NULL] MN; TO_STRING [MN, NULL] MNS; PRINT2 MNS;

MEMBER [LIST, N3] M1;  BRANCH(M1) { print has 3; } ELSE { print no 3; }
MEMBER [LIST, N99] M2; BRANCH(M2) { print has 99; } ELSE { print no 99; }

// TAKE 2 -> [4, 3]: length 2, sum 7. DROP 2 -> [8]: sum 8.
TAKE [LIST, N2] T;
LENGTH [T, NULL] TL; TO_STRING [TL, NULL] TLS; PRINT2 TLS;
SUM [T, NULL] TS;    TO_STRING [TS, NULL] TSS; PRINT2 TSS;
DROP [LIST, N2] D;
SUM [D, NULL] DS;    TO_STRING [DS, NULL] DSS; PRINT2 DSS;

THIS.DIE();
