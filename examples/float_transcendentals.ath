// Demonstrates the float transcendental builtins (§4.8.2). Only exactly
// representable results are printed so the output is platform-stable.
//
//   athc examples/float_transcendentals.ath -o ft
//   ./ft
//   # expected:
//   # sqrt(16) = 4.0
//   # sqrt(2.25) = 1.5
//   # hypot(3, 4) = 5.0
//   # exp(0) = 1.0
//   # log(1) = 0.0
//   # cos(0) = 1.0

IMPORTF <to_string> AS TS;
IMPORTF <sqrt> AS SQRT;
IMPORTF <hypot> AS HYPOT;
IMPORTF <exp> AS EXP;
IMPORTF <log> AS LOG;
IMPORTF <cos> AS COS;

IMPORT NUMBER 16 AS N16;
SQRT[N16, N16] A;
TS[A, A] AST;
PRINT sqrt(16) = $AST;
IMPORT NUMBER 2.25 AS Q;
SQRT[Q, Q] B;
TS[B, B] BS;
PRINT sqrt(2.25) = $BS;
IMPORT NUMBER 3.0 AS X3;
IMPORT NUMBER 4.0 AS X4;
HYPOT[X3, X4] C;
TS[C, C] CS;
PRINT hypot(3, 4) = $CS;
IMPORT NUMBER 0.0 AS Z;
EXP[Z, Z] D;
TS[D, D] DS;
PRINT exp(0) = $DS;
IMPORT NUMBER 1.0 AS ONE;
LOG[ONE, ONE] E;
TS[E, E] ES;
PRINT log(1) = $ES;
COS[Z, Z] G;
TS[G, G] GS;
PRINT cos(0) = $GS;

THIS.DIE();
