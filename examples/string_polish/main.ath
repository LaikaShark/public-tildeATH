// Tier 3k: string polish — capitalize, title, char_at, find_from (packed
// needle+start), strip_chars, and custom-fill pad.
//
//   printf 'hello world\n' | ./sp
//   # Hello world / Hello World / h / 7 / hello world / .hello world

IMPORTF <capitalize>    AS CAPITALIZE;
IMPORTF <title>         AS TITLE;
IMPORTF <char_at>       AS CHAR_AT;
IMPORTF <find_from>     AS FIND_FROM;
IMPORTF <strip_chars>   AS STRIP_CHARS;
IMPORTF <pad_left_with> AS PAD_LEFT_WITH;
IMPORTF <to_string>     AS TO_STRING;
IMPORTF <entangle>      AS ENTANGLE;

INPUT S;

CAPITALIZE[S, NULL] CAP;
PRINT $CAP;
TITLE[S, NULL] TT;
PRINT $TT;

IMPORT NUMBER 0 AS I0;
CHAR_AT[S, I0] CA;
PRINT $CA;

// First 'o' at or after index 5.
TEXT "o" AS OO;
IMPORT NUMBER 5 AS FIVE;
ENTANGLE[OO, FIVE] NEEDLE_AT;
FIND_FROM[S, NEEDLE_AT] FF;
TO_STRING[FF, NULL] FFS;
PRINT $FFS;

// Strip dashes (none here) and left-pad to width 12 with dots.
TEXT "-" AS DASH;
STRIP_CHARS[S, DASH] SC;
PRINT $SC;

TEXT "." AS DOT;
IMPORT NUMBER 12 AS N12;
ENTANGLE[N12, DOT] PADSPEC;
PAD_LEFT_WITH[S, PADSPEC] PL;
PRINT $PL;

THIS.DIE();
