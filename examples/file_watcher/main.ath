// Watches a file at "target.txt" (relative to CWD when running). The
// loop body prints "watching" while the file exists. Try:
//
//   touch target.txt
//   ./file_watcher &
//   rm target.txt
//
// and the program will exit shortly after rm.

WATCH "target.txt" AS F;
~ATH(F)
{
    PRINT watching;
}
PRINT target is gone;
THIS.DIE();
