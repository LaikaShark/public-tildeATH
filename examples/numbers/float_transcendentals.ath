// Float transcendental builtins (sqrt, hypot, exp, log, cos). Output: sqrt(16) = 4.0 / sqrt(2.25) = 1.5 / hypot(3, 4) = 5.0 / exp(0) = 1.0 / log(1) = 0.0 / cos(0) = 1.0.

IMPORTF <to_string> AS TS;
IMPORTF <sqrt> AS SQRT;
IMPORTF <hypot> AS HYPOT;
IMPORTF <exp> AS EXP;
IMPORTF <log> AS LOG;
IMPORTF <cos> AS COS;

SQRT [16, 16]A;
TS [A, A]AST;
PRINT sqrt(16) = $AST;
SQRT [2.25, 2.25]B;
TS [B, B]BS;
PRINT sqrt(2.25) = $BS;
HYPOT [3.0, 4.0]C;
TS [C, C]CS;
PRINT hypot(3, 4) = $CS;
EXP [0.0, 0.0]D;
TS [D, D]DS;
PRINT exp(0) = $DS;
LOG [1.0, 1.0]E;
TS [E, E]ES;
PRINT log(1) = $ES;
COS [0.0, 0.0]G;
TS [G, G]GS;
PRINT cos(0) = $GS;

THIS.DIE();
