// Add two sentinel-encoded numbers (ARGS = compose(a, b)); return the encoded sum via THIS.DIE.

IMPORT S S;
BIFURCATE ARGS[A, B];
BIFURCATE A[ALEFT, AREST];

~ATH(ALEFT)
{
    // a > 1: add(a-1, b+1)
    BIFURCATE [S, B] BPLUS;
    ADD [AREST, BPLUS]R;
    THIS.DIE(R);
}

// a == 1: return b + 1
BIFURCATE [S, B] BPLUS;
THIS.DIE(BPLUS);
