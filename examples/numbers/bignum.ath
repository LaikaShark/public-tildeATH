// Exact arbitrary-precision integer arithmetic: literals beyond int64 are bignums that never overflow. Output: 99999999999999999999 + 1 = 100000000000000000000 / square = 9999999999999999999800000000000000000001 / square / big = 99999999999999999999 / big - (big-1) = 1.

IMPORTF <add> AS ADD;
IMPORTF <sub> AS SUB;
IMPORTF <mul> AS MUL;
IMPORTF <div> AS DIV;

ADD [99999999999999999999, 1]PLUS;
PRINT 99999999999999999999 + 1 = $PLUS;
MUL [99999999999999999999, 99999999999999999999]SQ;
PRINT square = $SQ;
DIV [SQ, 99999999999999999999]BACK;
PRINT square / big = $BACK;
SUB [99999999999999999999, 99999999999999999998]DIFF;
PRINT big - (big-1) = $DIFF;

THIS.DIE();
