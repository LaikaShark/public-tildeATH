// Tier 3g demo: case transforms, whitespace stripping, split + join.
//
// Reads one line S from stdin and prints, one per line:
//   1. S lowercased
//   2. S uppercased
//   3. S trimmed of leading/trailing whitespace
//   4. the trimmed value split on "," and re-joined with "-"
//
// SPLIT and JOIN are inverses when the separator does not occur inside
// an element; a trailing separator yields a trailing empty element.
//
// Try:
//   athc examples/string_transforms/main.ath -o st
//   printf '  Hello,World,FOO  \n' | ./st
//   # "  hello,world,foo  " / "  HELLO,WORLD,FOO  " / "Hello,World,FOO"
//   # / "Hello-World-FOO"

importf <lower> as LOWER;
importf <upper> as UPPER;
importf <trim>  as TRIM;
importf <split> as SPLIT;
importf <join>  as JOIN;

INPUT S;

LOWER [S, NULL] LO;
print $LO;

UPPER [S, NULL] UP;
print $UP;

TRIM [S, NULL] TR;
print $TR;

text "," as COMMA;
text "-" as DASH;
SPLIT [TR, COMMA] PARTS;
JOIN [PARTS, DASH] REJOINED;
print $REJOINED;

THIS.DIE();
