// sudoku solver by iterative backtracking. the 9x9 board is one 81-char
// string ('0' = blank); a second copy GIVEN remembers the clues so we never
// overwrite them. we walk cells in row-major order carrying a direction DIR
// (+1 forward, -1 backtracking): on a blank we try the smallest digit greater
// than its current value that breaks no row/column/box constraint -- placing it
// and stepping forward, or zeroing the cell and stepping back when none fits.
// POS reaching 81 means solved; POS falling below 0 means unsolvable. there
// are no 2-D arrays and no in-place mutation: each write rebuilds the board
// cons-by-cons with plain compose + CLONE (dep-less), the same trick the
// brainfuck tape uses, so lifetime-dependency chains never pile up.
//
//   athc examples/sudoku.ath -o sudoku
//   ./sudoku

IMPORTF <add> AS ADD;
IMPORTF <sub> AS SUB;
IMPORTF <mul> AS MUL;
IMPORTF <div> AS DIV;
IMPORTF <mod> AS MOD;
IMPORTF <lt> AS LT;
IMPORTF <le> AS LE;
IMPORTF <gt> AS GT;
IMPORTF <ge> AS GE;
IMPORTF <eq> AS EQ;
IMPORTF <ord> AS ORD;
IMPORTF <chr> AS CHR;
IMPORTF <concat> AS CONCAT;

IMPORT NUMBER 0 AS ZERO;
IMPORT NUMBER 1 AS ONE;
IMPORT NUMBER 3 AS THREE;
IMPORT NUMBER 9 AS NINE;
IMPORT NUMBER 81 AS N81;
IMPORT NUMBER 48 AS C48;

TEXT "." AS DOT;
TEXT "" AS MT;

// an easy puzzle (45 clues, unique solution). naive row-major backtracking is
// exponential in the worst case, so the example sticks to a puzzle the solver
// clears with little search; harder grids work too, just slower.
TEXT "000078912002195300198340000859000023400003791000924850061537000287400005340000179" AS GIVEN;
TEXT "000078912002195300198340000859000023400003791000924850061537000287400005340000179" AS GRID;

// --- print a board (reads GRID; blanks shown as '.') -----------------------
TEXT "puzzle:" AS HDR1;
PRINT $HDR1;
IMPORT NUMBER 0 AS PR;
LT[PR, NINE] PRL;
~ATH(PRL)
{
    TEXT "" AS ROW;
    ADD[ZERO, ZERO] PC;
    LT[PC, NINE] PCL;
    ~ATH(PCL)
    {
        MUL[PR, NINE] PRB;
        ADD[PRB, PC] PIDX;
        GRID[PIDX] PCC;
        ORD[PCC, NULL] PCO;
        SUB[PCO, C48] PV;
        EQ[PV, ZERO] BLANK;
        BRANCH(BLANK)
        {
            CONCAT[ROW, DOT] ROW;
        }
        ELSE
        {
            CHR[PCO, NULL] DCS;
            CONCAT[ROW, DCS] ROW;
        }
        ADD[PC, ONE] PC;
        LT[PC, NINE] PCL;
    }
    PRINT $ROW;
    ADD[PR, ONE] PR;
    LT[PR, NINE] PRL;
}

// --- solve: row-major iterative backtracking -------------------------------
IMPORT NUMBER 0 AS POS;
IMPORT NUMBER 1 AS DIR;
LT[POS, N81] RUN;
~ATH(RUN)
{
    GIVEN[POS] GCH;
    ORD[GCH, NULL] GO;
    SUB[GO, C48] GV;
    GT[GV, ZERO] ISGIVEN;
    BRANCH(ISGIVEN)
    {
        // clue: keep moving the way we came
        ADD[POS, DIR] POS;
    }
    ELSE
    {
        DIV[POS, NINE] R;
        MOD[POS, NINE] C;
        GRID[POS] CCH;
        ORD[CCH, NULL] CO;
        SUB[CO, C48] CUR;

        // smallest digit > CUR that fits, if any
        ADD[ZERO, ZERO] PLACED;
        ADD[ZERO, ZERO] FOUNDD;
        ADD[CUR, ONE] D;
        LE[D, NINE] TRYL;
        ~ATH(TRYL)
        {
            ADD[ZERO, ZERO] CONFLICT;

            // row R
            ADD[ZERO, ZERO] SC;
            LT[SC, NINE] ROWL;
            ~ATH(ROWL)
            {
                MUL[R, NINE] RB;
                ADD[RB, SC] RI;
                GRID[RI] RGC;
                ORD[RGC, NULL] RGO;
                SUB[RGO, C48] RGV;
                EQ[RGV, D] RHIT;
                BRANCH(RHIT)
                {
                    ADD[CONFLICT, ONE] CONFLICT;
                }
                ADD[SC, ONE] SC;
                LT[SC, NINE] ROWL;
            }

            // column C
            ADD[ZERO, ZERO] SR;
            LT[SR, NINE] COLL;
            ~ATH(COLL)
            {
                MUL[SR, NINE] CB;
                ADD[CB, C] CI;
                GRID[CI] CGC;
                ORD[CGC, NULL] CGO;
                SUB[CGO, C48] CGV;
                EQ[CGV, D] CHIT;
                BRANCH(CHIT)
                {
                    ADD[CONFLICT, ONE] CONFLICT;
                }
                ADD[SR, ONE] SR;
                LT[SR, NINE] COLL;
            }

            // 3x3 box
            DIV[R, THREE] R3;
            MUL[R3, THREE] BR;
            DIV[C, THREE] C3;
            MUL[C3, THREE] BC;
            ADD[ZERO, ZERO] BI;
            LT[BI, THREE] BIL;
            ~ATH(BIL)
            {
                ADD[ZERO, ZERO] BJ;
                LT[BJ, THREE] BJL;
                ~ATH(BJL)
                {
                    ADD[BR, BI] BROW;
                    MUL[BROW, NINE] BBASE;
                    ADD[BC, BJ] BCOL;
                    ADD[BBASE, BCOL] BIDX;
                    GRID[BIDX] BGC;
                    ORD[BGC, NULL] BGO;
                    SUB[BGO, C48] BGV;
                    EQ[BGV, D] BHIT;
                    BRANCH(BHIT)
                    {
                        ADD[CONFLICT, ONE] CONFLICT;
                    }
                    ADD[BJ, ONE] BJ;
                    LT[BJ, THREE] BJL;
                }
                ADD[BI, ONE] BI;
                LT[BI, THREE] BIL;
            }

            EQ[CONFLICT, ZERO] FITS;
            BRANCH(FITS)
            {
                ADD[ONE, ZERO] PLACED;
                ADD[D, ZERO] FOUNDD;
                // force-exit the digit loop
                ADD[NINE, NINE] D;
            }
            ELSE
            {
                ADD[D, ONE] D;
            }
            LE[D, NINE] TRYL;
        }

        // NEWDIG = chosen digit (forward) or 0 (backtrack). BRANCH is one-shot
        // (it consumes its verdict), so each use of the placed/not-placed test
        // recomputes a fresh verdict.
        ADD[ZERO, ZERO] NEWDIG;
        GT[PLACED, ZERO] DIDPLACE;
        BRANCH(DIDPLACE)
        {
            ADD[FOUNDD, ZERO] NEWDIG;
        }

        // write NEWDIG at POS, rebuilding GRID dep-lessly
        ADD[NEWDIG, C48] NDC;
        CHR[NDC, NULL] NDS;
        NDS[ZERO] NDA0;
        CLONE NDA0 AS NDATOM;
        BIFURCATE NULL[GJX, GACC];
        SUB[N81, ONE] GTM;
        ADD[ZERO, ZERO] GJ;
        LT[GJ, N81] GRGO;
        ~ATH(GRGO)
        {
            SUB[GTM, GJ] GIDX;
            EQ[GIDX, POS] GISHERE;
            BRANCH(GISHERE)
            {
                BIFURCATE [NDATOM, GACC] GACC;
            }
            ELSE
            {
                GRID[GIDX] GOA;
                CLONE GOA AS GCA;
                BIFURCATE [GCA, GACC] GACC;
            }
            ADD[GJ, ONE] GJ;
            LT[GJ, N81] GRGO;
        }
        BIFURCATE GACC[GAH, GAT];
        BIFURCATE [GAH, GAT] GRID;

        // step: forward on a placement, backtrack otherwise (fresh verdict)
        GT[PLACED, ZERO] DOSTEP;
        BRANCH(DOSTEP)
        {
            ADD[ONE, ZERO] DIR;
            ADD[POS, ONE] POS;
        }
        ELSE
        {
            SUB[ZERO, ONE] DIR;
            SUB[POS, ONE] POS;
        }
    }
    LT[POS, N81] RUN;
}

// --- print the solution ----------------------------------------------------
TEXT "solved:" AS HDR2;
PRINT $HDR2;
ADD[ZERO, ZERO] PR;
LT[PR, NINE] PRL2;
~ATH(PRL2)
{
    TEXT "" AS ROW2;
    ADD[ZERO, ZERO] PC;
    LT[PC, NINE] PCL2;
    ~ATH(PCL2)
    {
        MUL[PR, NINE] PRB;
        ADD[PRB, PC] PIDX;
        GRID[PIDX] PCC;
        ORD[PCC, NULL] PCO;
        CHR[PCO, NULL] DCS;
        CONCAT[ROW2, DCS] ROW2;
        ADD[PC, ONE] PC;
        LT[PC, NINE] PCL2;
    }
    PRINT $ROW2;
    ADD[PR, ONE] PR;
    LT[PR, NINE] PRL2;
}

THIS.DIE();
