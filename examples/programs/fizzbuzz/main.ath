// Three mutually-recursive functions cycle FIZZ -> BUZZ -> FIZZBUZZ, starting from FIZZ with a counter of 6. Output: fizz, buzz, fizzbuzz, fizz, buzz, fizzbuzz (one per line).

IMPORTF "fizz.ath" AS FIZZ;
IMPORTF "buzz.ath" AS BUZZ;
IMPORTF "fizzbuzz.ath" AS FIZZBUZZ;

IMPORT SENTINEL S;
BIFURCATE [NULL, S] N1;
BIFURCATE [S, N1] N2;
BIFURCATE [S, N2] N3;
BIFURCATE [S, N3] N4;
BIFURCATE [S, N4] N5;
BIFURCATE [S, N5] N6;

FIZZ N6[X, Y];
THIS.DIE();
