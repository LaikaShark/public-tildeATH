// Solve a Sudoku by iterative row-major backtracking over an 81-char board string (GIVEN holds the clues). Output: the puzzle as a 9x9 grid, then the solved 9x9 grid.

IMPORTF <add> AS ADD;
IMPORTF <sub> AS SUB;
IMPORTF <mul> AS MUL;
IMPORTF <div> AS DIV;
IMPORTF <mod> AS MOD;
IMPORTF <lt> AS LT;
IMPORTF <le> AS LE;
IMPORTF <gt> AS GT;
IMPORTF <ge> AS GE;
IMPORTF <eq> AS EQ;
IMPORTF <ord> AS ORD;
IMPORTF <chr> AS CHR;
IMPORTF <concat> AS CONCAT;

TEXT "" AS MT;

// an easy puzzle (45 clues, unique solution). naive row-major backtracking is
// exponential in the worst case, so the example sticks to a puzzle the solver
// clears with little search; harder grids work too, just slower.
TEXT "000078912002195300198340000859000023400003791000924850061537000287400005340000179" AS GIVEN;
TEXT "000078912002195300198340000859000023400003791000924850061537000287400005340000179" AS GRID;

// --- print a board (reads GRID; blanks shown as '.') -----------------------
TEXT "puzzle:" AS HDR1;
PRINT $HDR1;
IMPORT NUMBER 0 AS PR;
LT [PR, 9]PRL;
~ATH(PRL)
{
    TEXT "" AS ROW;
    ADD [0, 0]PC;
    LT [PC, 9]PCL;
    ~ATH(PCL)
    {
        MUL [PR, 9]PRB;
        ADD [PRB, PC]PIDX;
        GRID[PIDX] PCC;
        ORD [PCC, NULL]PCO;
        SUB [PCO, 48]PV;
        EQ [PV, 0]BLANK;
        BRANCH(BLANK)
        {
            CONCAT [ROW, "."]ROW;
        }
        ELSE
        {
            CHR [PCO, NULL]DCS;
            CONCAT [ROW, DCS]ROW;
        }
        ADD [PC, 1]PC;
        LT [PC, 9]PCL;
    }
    PRINT $ROW;
    ADD [PR, 1]PR;
    LT [PR, 9]PRL;
}

// --- solve: row-major iterative backtracking -------------------------------
IMPORT NUMBER 0 AS POS;
IMPORT NUMBER 1 AS DIR;
LT [POS, 81]RUN;
~ATH(RUN)
{
    GIVEN[POS] GCH;
    ORD [GCH, NULL]GO;
    SUB [GO, 48]GV;
    GT [GV, 0]ISGIVEN;
    BRANCH(ISGIVEN)
    {
        // clue: keep moving the way we came
        ADD [POS, DIR]POS;
    }
    ELSE
    {
        DIV [POS, 9]R;
        MOD [POS, 9]C;
        GRID[POS] CCH;
        ORD [CCH, NULL]CO;
        SUB [CO, 48]CUR;

        // smallest digit > CUR that fits, if any
        ADD [0, 0]PLACED;
        ADD [0, 0]FOUNDD;
        ADD [CUR, 1]D;
        LE [D, 9]TRYL;
        ~ATH(TRYL)
        {
            ADD [0, 0]CONFLICT;

            // row R
            ADD [0, 0]SC;
            LT [SC, 9]ROWL;
            ~ATH(ROWL)
            {
                MUL [R, 9]RB;
                ADD [RB, SC]RI;
                GRID[RI] RGC;
                ORD [RGC, NULL]RGO;
                SUB [RGO, 48]RGV;
                EQ [RGV, D]RHIT;
                BRANCH(RHIT)
                {
                    ADD [CONFLICT, 1]CONFLICT;
                }
                ADD [SC, 1]SC;
                LT [SC, 9]ROWL;
            }

            // column C
            ADD [0, 0]SR;
            LT [SR, 9]COLL;
            ~ATH(COLL)
            {
                MUL [SR, 9]CB;
                ADD [CB, C]CI;
                GRID[CI] CGC;
                ORD [CGC, NULL]CGO;
                SUB [CGO, 48]CGV;
                EQ [CGV, D]CHIT;
                BRANCH(CHIT)
                {
                    ADD [CONFLICT, 1]CONFLICT;
                }
                ADD [SR, 1]SR;
                LT [SR, 9]COLL;
            }

            // 3x3 box
            DIV [R, 3]R3;
            MUL [R3, 3]BR;
            DIV [C, 3]C3;
            MUL [C3, 3]BC;
            ADD [0, 0]BI;
            LT [BI, 3]BIL;
            ~ATH(BIL)
            {
                ADD [0, 0]BJ;
                LT [BJ, 3]BJL;
                ~ATH(BJL)
                {
                    ADD [BR, BI]BROW;
                    MUL [BROW, 9]BBASE;
                    ADD [BC, BJ]BCOL;
                    ADD [BBASE, BCOL]BIDX;
                    GRID[BIDX] BGC;
                    ORD [BGC, NULL]BGO;
                    SUB [BGO, 48]BGV;
                    EQ [BGV, D]BHIT;
                    BRANCH(BHIT)
                    {
                        ADD [CONFLICT, 1]CONFLICT;
                    }
                    ADD [BJ, 1]BJ;
                    LT [BJ, 3]BJL;
                }
                ADD [BI, 1]BI;
                LT [BI, 3]BIL;
            }

            EQ [CONFLICT, 0]FITS;
            BRANCH(FITS)
            {
                ADD [1, 0]PLACED;
                ADD [D, 0]FOUNDD;
                // force-exit the digit loop
                ADD [9, 9]D;
            }
            ELSE
            {
                ADD [D, 1]D;
            }
            LE [D, 9]TRYL;
        }

        // NEWDIG = chosen digit (forward) or 0 (backtrack). BRANCH is one-shot
        // (it consumes its verdict), so each use of the placed/not-placed test
        // recomputes a fresh verdict.
        ADD [0, 0]NEWDIG;
        GT [PLACED, 0]DIDPLACE;
        BRANCH(DIDPLACE)
        {
            ADD [FOUNDD, 0]NEWDIG;
        }

        // write NEWDIG at POS, rebuilding GRID dep-lessly
        ADD [NEWDIG, 48]NDC;
        CHR [NDC, NULL]NDS;
        NDS[0] NDA0;
        CLONE NDA0 AS NDATOM;
        BIFURCATE NULL[GJX, GACC];
        SUB [81, 1]GTM;
        ADD [0, 0]GJ;
        LT [GJ, 81]GRGO;
        ~ATH(GRGO)
        {
            SUB [GTM, GJ]GIDX;
            EQ [GIDX, POS]GISHERE;
            BRANCH(GISHERE)
            {
                BIFURCATE [NDATOM, GACC] GACC;
            }
            ELSE
            {
                GRID[GIDX] GOA;
                CLONE GOA AS GCA;
                BIFURCATE [GCA, GACC] GACC;
            }
            ADD [GJ, 1]GJ;
            LT [GJ, 81]GRGO;
        }
        BIFURCATE GACC[GAH, GAT];
        BIFURCATE [GAH, GAT] GRID;

        // step: forward on a placement, backtrack otherwise (fresh verdict)
        GT [PLACED, 0]DOSTEP;
        BRANCH(DOSTEP)
        {
            ADD [1, 0]DIR;
            ADD [POS, 1]POS;
        }
        ELSE
        {
            SUB [0, 1]DIR;
            SUB [POS, 1]POS;
        }
    }
    LT [POS, 81]RUN;
}

// --- print the solution ----------------------------------------------------
TEXT "solved:" AS HDR2;
PRINT $HDR2;
ADD [0, 0]PR;
LT [PR, 9]PRL2;
~ATH(PRL2)
{
    TEXT "" AS ROW2;
    ADD [0, 0]PC;
    LT [PC, 9]PCL2;
    ~ATH(PCL2)
    {
        MUL [PR, 9]PRB;
        ADD [PRB, PC]PIDX;
        GRID[PIDX] PCC;
        ORD [PCC, NULL]PCO;
        CHR [PCO, NULL]DCS;
        CONCAT [ROW2, DCS]ROW2;
        ADD [PC, 1]PC;
        LT [PC, 9]PCL2;
    }
    PRINT $ROW2;
    ADD [PR, 1]PR;
    LT [PR, 9]PRL2;
}

THIS.DIE();
