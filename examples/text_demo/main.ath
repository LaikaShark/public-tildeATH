// Demonstrates the `text` statement (§4.4.25).
//
//   athc examples/text_demo/main.ath -o td
//   ./td
//   # expected:
//   # hello world
//   # value: 42
//   # x=7
//   # y=8
//   # sum=15

IMPORTF <add> AS ADD;

// Primitive form: a single string literal becomes a string value.
TEXT "hello world" AS GREETING;
PRINT $GREETING;

// Interpolation form: literals and identifiers interleave. Identifiers
// carrying an int64 payload are coerced through TO_STRING; identifiers
// already holding a string pass through unchanged.
IMPORT NUMBER 42 AS N;
TEXT "value: " N AS MSG;
PRINT $MSG;

IMPORT NUMBER 7 AS X;
IMPORT NUMBER 8 AS Y;
ADD[X, Y] S;

TEXT "x=" X AS XLINE;
PRINT $XLINE;
TEXT "y=" Y AS YLINE;
PRINT $YLINE;
TEXT "sum=" S AS SLINE;
PRINT $SLINE;

THIS.DIE();
