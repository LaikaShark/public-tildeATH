// Roll a single d6, print the result. Random is seeded by ATH_SEED
// (env var); without ATH_SEED, the seed comes from the wall clock and
// runs are non-deterministic.
//
//   athc examples/random/main.ath -o roll
//   ATH_SEED=42 ./roll
//   # => 1
//
//   ATH_SEED=99 ./roll
//   # => 5

IMPORTF <random>    AS RANDOM;
IMPORTF <to_string> AS TO_STRING;

IMPORT NUMBER 1 AS LO;
IMPORT NUMBER 7 AS HI;
// exclusive — gives [1, 7) = 1..6
RANDOM[LO, HI] ROLL;
TO_STRING[ROLL, NULL] OUT;
PRINT $OUT;

THIS.DIE();
