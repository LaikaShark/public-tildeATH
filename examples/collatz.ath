// Collatz (3n+1) trajectory from a fixed seed. While n != 1: halve if even,
// else 3n+1. Demonstrates a conditional ~ATH loop driven by a recomputed
// verdict, integer arithmetic, a parity BRANCH, and numeric `$N`
// interpolation (no TO_STRING needed).
//
//   athc examples/collatz.ath -o collatz
//   ./collatz
//   # expected:
//   # 6
//   # 3
//   # 10
//   # 5
//   # 16
//   # 8
//   # 4
//   # 2
//   # 1
//   # reached 1 in 8 steps

IMPORTF <mod> AS MOD;
IMPORTF <div> AS DIV;
IMPORTF <mul> AS MUL;
IMPORTF <add> AS ADD;
IMPORTF <eq> AS EQ;
IMPORTF <ne> AS NE;

IMPORT NUMBER 6 AS N;
IMPORT NUMBER 0 AS STEPS;
IMPORT NUMBER 0 AS ZERO;
IMPORT NUMBER 1 AS ONE;
IMPORT NUMBER 2 AS TWO;
IMPORT NUMBER 3 AS THREE;

PRINT $N;

NE[N, ONE] GOING;
~ATH(GOING)
{
    MOD[N, TWO] R;
    EQ[R, ZERO] EVEN;
    BRANCH(EVEN)
    {
        DIV[N, TWO] N;
    }
    ELSE
    {
        MUL[N, THREE] M;
        ADD[M, ONE] N;
    }
    ADD[STEPS, ONE] STEPS;
    PRINT $N;
    NE[N, ONE] GOING;
}

PRINT reached 1 in $STEPS steps;
THIS.DIE();
