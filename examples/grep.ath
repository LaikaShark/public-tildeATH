// A tiny `grep`: the first input line is the pattern; every later line that
// CONTAINS it is echoed. A `~ATH(LINE)` read loop + a CONTAINS verdict +
// BRANCH. (As in `wc`, a blank line ends input.)
//
//   athc examples/grep.ath -o grep
//   printf 'err\nerror 1\nok\nerror 2\n' | ./grep
//   # expected:
//   # error 1
//   # error 2

IMPORTF <contains> AS CONTAINS;

INPUT PAT;                       // first line: the search pattern
INPUT LINE;
~ATH(LINE)
{
    CONTAINS[LINE, PAT] HIT;
    BRANCH(HIT)
    {
        PRINT $LINE;
    }

    INPUT LINE;
}
THIS.DIE();
