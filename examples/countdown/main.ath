// Build the positive integer 3 — a chain of objects whose left half is
// alive for "successor" levels and NULL at the base — then recurse on it,
// printing "tick" once per level.
//
// Encoding:
//   1 = compose(NULL, anything)
//   n+1 = compose(alive-sentinel, n)

IMPORTF "countdown.ath" AS COUNTDOWN;

IMPORT SENTINEL S;
BIFURCATE [NULL, S] ONE;
BIFURCATE [S, ONE]  TWO;
BIFURCATE [S, TWO]  THREE;

COUNTDOWN THREE[A, B];

PRINT done;
THIS.DIE();
