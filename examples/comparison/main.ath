// Reads two decimal integers from stdin (one per line) and reports the
// ordering between them.
//
//   athc examples/comparison/main.ath -o cmp
//   printf '3\n10\n' | ./cmp     # => less
//   printf '10\n3\n' | ./cmp     # => greater
//   printf '7\n7\n'  | ./cmp     # => equal
//
// Each "branch" is a ~ATH loop that runs at most once: the verdict is
// alive iff the comparison holds, the body kills it, the loop exits.

IMPORTF <parse> AS PARSE;
IMPORTF <lt> AS LT;
IMPORTF <eq> AS EQ;
IMPORTF <gt> AS GT;

INPUT LINE_X;
INPUT LINE_Y;

PARSE[LINE_X, NULL] X;
PARSE[LINE_Y, NULL] Y;

LT[X, Y] IS_LT;
~ATH(IS_LT)
{
    PRINT less;
    IS_LT.DIE();
}

EQ[X, Y] IS_EQ;
~ATH(IS_EQ)
{
    PRINT equal;
    IS_EQ.DIE();
}

GT[X, Y] IS_GT;
~ATH(IS_GT)
{
    PRINT greater;
    IS_GT.DIE();
}

THIS.DIE();
